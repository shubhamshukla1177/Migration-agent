# db-gate config. `make gate` loads this file; so does db_gate/server.py when run directly.
# Two least-privilege roles created by `make seed`:
READER_URL=postgresql://gate_reader:READER_PW@HOST/appdb?sslmode=require
MIGRATOR_URL=postgresql://gate_migrator:MIGRATOR_PW@HOST/appdb?sslmode=require
# Role that owns the tables; apply_migration runs `SET LOCAL ROLE` to it so new objects get the same owner.
MIGRATION_ROLE=app_owner

# Bearer token TrueForge sends to the gate:  openssl rand -hex 24
GATE_TOKEN=
GATE_HOST=127.0.0.1
GATE_PORT=8811

# Used by `make agent` (agent/register.py)
TRUEFORGE_URL=http://localhost:8790
# Where TrueForge fetches the skill from (Settings -> Skills). Pin to a tag or commit.
SKILL_REPO=https://github.com/<you>/release-gate
SKILL_REF=main
